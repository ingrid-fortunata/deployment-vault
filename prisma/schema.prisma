generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companies    Company[]

  @@index([email])
}

model Company {
  id          String    @id @default(cuid())
  name        String
  description String?
  website     String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Project {
  id                 String                  @id @default(cuid())
  name               String
  description        String?
  companyId          String
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  repositories       Repository[]
  deployments        DeploymentEnvironment[]
  backendDocs        BackendDocumentation[]
  documents          ProjectDocument[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([companyId])
}

model Repository {
  id        String   @id @default(cuid())
  title     String
  url       String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model DeploymentEnvironment {
  id              String   @id @default(cuid())
  environment     String   // production | staging | development
  deploymentUrl   String?
  credentials     String?  // encrypted
  envFileContent  String?  // encrypted
  notes           String?  // encrypted
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, environment])
  @@index([projectId])
}

model BackendDocumentation {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectDocument {
  id        String   @id @default(cuid())
  title     String
  type      String   // link | note | credential | document
  value     String?  // encrypted when type is credential or note
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
